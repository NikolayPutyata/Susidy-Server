PORT=3000
MONGODB_URI=

# Optional: a separate reserve MongoDB that keeps only name + phone of
# everyone who ordered or registered (one record per phone). Must be a
# different database from MONGODB_URI. Leave blank to turn off.
BACKUP_MONGODB_URI=

# comma-separated list of frontend origins allowed to call this API with
# credentials (cookies); e.g. http://localhost:5173,https://susidy.example
CLIENT_ORIGIN=

# set to "true" when the API and the frontend are on different sites
# (e.g. api on Render, frontend on Vercel) — makes session cookies
# SameSite=None; Secure so the browser actually sends them cross-site.
# Requires HTTPS. Leave unset/false for local dev (same-site localhost).
COOKIE_SECURE=

TELEGRAM_KEY=
TELEGRAM_CHAT_ID=

# Optional: the owner's private bot — gets a copy of EVERY order from every
# point (not the admins' shared fallback above). Leave blank to turn off.
TELEGRAM_KEY_OWNER=
TELEGRAM_CHAT_ID_OWNER=

# Optional: a dedicated bot per pickup point. A pickup order for a point
# without its own bot configured here falls back to TELEGRAM_KEY/_CHAT_ID
# above — same for every delivery order, since those aren't yet assigned
# to a point (see README).
TELEGRAM_KEY_KYIV_BERESTEJSKYI=
TELEGRAM_CHAT_ID_KYIV_BERESTEJSKYI=
TELEGRAM_KEY_KYIV_DRAGOMANOVA=
TELEGRAM_CHAT_ID_KYIV_DRAGOMANOVA=
TELEGRAM_KEY_KHARKIV_VALENTYNIVSKA=
TELEGRAM_CHAT_ID_KHARKIV_VALENTYNIVSKA=
TELEGRAM_KEY_KHARKIV_DIVISIONS=
TELEGRAM_CHAT_ID_KHARKIV_DIVISIONS=
TELEGRAM_KEY_KHARKIV_SVOBODY=
TELEGRAM_CHAT_ID_KHARKIV_SVOBODY=

# TurboSMS (turbosms.ua) — SMS codes for registration and password reset.
# Token: TurboSMS cabinet → Connect → API. Sender: your alpha-name exactly
# as approved by TurboSMS (e.g. SUSIDY).
TURBOSMS_TOKEN=
TURBOSMS_SENDER=
# Max SMS in any 24h across the whole site (protection against abuse).
SMS_DAILY_LIMIT=500
# Local development only: "true" prints codes to the server log instead of
# sending SMS. Never set this in production.
SMS_DEV_MODE=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Poster POS (joinposter.com) — optional. Leave both blank and the
# integration is a no-op. A personal access token: Poster admin panel →
# Settings → Access → Integrations → Personal integration. Account name is
# the subdomain in your Poster login URL (https://<this>.joinposter.com).
POSTER_ACCOUNT_NAME=
POSTER_ACCESS_TOKEN=

# Each pickup point's numeric spot_id in Poster (Settings → Access →
# Establishments) — a point left blank here just isn't pushed to Poster.
# Also required per product: set "Poster product ID" on each item in the
# admin panel (Товари) — an order with any unmapped item isn't pushed
# either (see the server log for which one).
POSTER_SPOT_ID_KYIV_BERESTEJSKYI=
POSTER_SPOT_ID_KYIV_DRAGOMANOVA=
POSTER_SPOT_ID_KHARKIV_VALENTYNIVSKA=
POSTER_SPOT_ID_KHARKIV_DIVISIONS=
POSTER_SPOT_ID_KHARKIV_SVOBODY=

# used only by `npm run seed:admin`
ADMIN_NAME=
ADMIN_PHONE=
ADMIN_PASSWORD=

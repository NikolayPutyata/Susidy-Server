PORT=3000
MONGODB_URI=

# comma-separated list of frontend origins allowed to call this API with
# credentials (cookies); e.g. http://localhost:5173,https://susidy.example
CLIENT_ORIGIN=

# set to "true" when the API and the frontend are on different sites
# (e.g. api on Render, frontend on Vercel) — makes session cookies
# SameSite=None; Secure so the browser actually sends them cross-site.
# Requires HTTPS. Leave unset/false for local dev (same-site localhost).
COOKIE_SECURE=

TELEGRAM_KEY=
TELEGRAM_CHAT_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# used only by `npm run seed:admin`
ADMIN_NAME=
ADMIN_PHONE=
ADMIN_PASSWORD=
